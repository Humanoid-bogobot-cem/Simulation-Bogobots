	<xacro:macro name="foot" params="name x y z row pitch yaw">
        <link name="${name}">
            <collision>
                <origin xyz="${x} ${y} ${z}" rpy="${row} ${pitch} ${yaw}" />
                <geometry>
                    <box size="0.15 0.2 0.01"/>
                </geometry>
            </collision>
            <visual>
                <origin xyz="${x} ${y} ${z}" rpy="${row} ${pitch} ${yaw}" />
                <geometry>
                    <box size="0.15 0.2 0.01"/>
                </geometry>
            </visual>
        </link>
    </xacro:macro>
</robot>

