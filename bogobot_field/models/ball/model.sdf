<?xml version="1.0" ?>
<sdf version="1.10">

  <model name="ball">
    <link name="ball_link">
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>7.146e-4</ixx><iyy>7.146e-4</iyy><izz>7.146e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="ball_collision">
        <geometry>
          <sphere><radius>0.0732</radius></sphere>
        </geometry>
      </collision>

      <visual name="ball_visual">
        <geometry>
          <mesh><uri>model://ball/meshes/ball.obj</uri></mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
